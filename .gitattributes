# Line endings are LF in the repository, and LF on checkout — Windows included.
#
# This is not a preference: the tests read versioned files and compare them to
# what maxx writes, which is always LF. A CRLF checkout makes those comparisons
# fail for a reason that has nothing to do with the code. That is exactly what
# turned the first Windows CI red.
* text=auto eol=lf

# The lock file and the templates are read by tests: never convert them.
Cargo.lock -text
demo/** -text

# Images are binary: never line-ending conversion.
*.png binary
*.gif binary
